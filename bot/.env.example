# Скопируй в .env и заполни. Файл .env в git НЕ коммитится.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов (блогера) через запятую. Свой ID узнать: напиши боту /myid
ADMIN_IDS=123456789

# Supabase — проект IMARSEN
SUPABASE_URL=https://mranatvgldcooncqaaan.supabase.co
# service_role ключ: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_KEY=eyJ...

# false = тест-режим (талон бесплатно), true = оплата звёздами
PAID_MODE=false
# Цена талона в звёздах
TICKET_PRICE_STARS=50
